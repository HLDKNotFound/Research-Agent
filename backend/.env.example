# ==============================================================================
# AI Agentic Research Platform - Environment Configuration Example
# ==============================================================================

# Application Metadata & Runtime
APP_NAME="AI Agentic Research Platform"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/research_agent"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Vector Embeddings
EMBEDDING_DIMENSION=1536

# Redis Caching & Queue
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=true
CACHE_VERSION="v1"
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_LONG_TTL_SECONDS=3600
CACHE_SHORT_TTL_SECONDS=60

# Security, HTTPS & JWT Authentication
FORCE_HTTPS=false
BEHIND_PROXY=true
ALLOWED_HOSTS=["*"]
BCRYPT_MAX_PASSWORD_BYTES=72
AUTH_RATE_LIMIT_PER_MINUTE=15
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage (local, s3, minio)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="research-agent-files"
STORAGE_LOCAL_PATH="/tmp/research_agent_storage"
STORAGE_ENDPOINT_URL=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# External AI & Search Providers (Google Gemini 2.5 Flash, OpenAI, Tavily)
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.5-flash"
GEMINI_API_KEY="AIzaSy..."
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
TAVILY_API_KEY=""
OPENAI_API_KEY=""
